; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PetApp"
run/main_scene="uid://cb2gcs6gpcges"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
boot_splash/bg_color=Color(0.14117648, 0.14117648, 0.14117648, 0)
boot_splash/show_image=false
config/icon="uid://h76owxnpqyrv"
config/macos_native_icon="res://App/PetAppIcon.icns"
config/windows_native_icon="res://App/PetAppIcon.ico"

[autoload]

DesktopPet="*uid://co04yugpp7caa"
AddMenu="*uid://b8q28jehwmnsr"
EventBus="*uid://dvbky6tt2vnip"
FloorManager="*uid://dacvr34dslb83"

[display]

window/size/mode=3
window/size/resizable=false
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/per_pixel_transparency/allowed=true

[dotnet]

project/assembly_name="FatPets"

[editor_plugins]

enabled=PackedStringArray("res://addons/pet_exporter/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.3019608, 0.3019608, 0.3019608, 0)
viewport/transparent_background=true
